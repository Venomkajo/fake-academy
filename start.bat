@echo off
setlocal EnableExtensions

REM ============================================================
REM  Fake Academy - dev environment bootstrap (Windows)
REM
REM  Usage:
REM    start.bat          build + start everything (idempotent -
REM                       safe to run again at any time)
REM    start.bat reset    FULL WIPE (containers, volumes, images,
REM                       build cache) followed by a fresh start
REM
REM  Steps:
REM    1. verify Docker is installed and the daemon is running
REM    2. create .env / frontend\.env with dev defaults if missing
REM    3. docker compose build   (backend + frontend images)
REM    4. docker compose up -d   (db, storage, backend, frontend)
REM    5. wait for the backend HTTP health endpoint
REM    6. alembic upgrade head   (DB schema, inside backend image)
REM    7. python scripts/seed.py (dev users + fake uni structure)
REM ============================================================

cd /d "%~dp0"

if /i "%~1"=="reset" goto :reset
if /i "%~1"=="--reset" goto :reset
goto :check

:reset
echo.
echo === RESET: usuwanie kontenerow, wolumenow, obrazow i cache ===
docker compose down -v --rmi all --remove-orphans
if errorlevel 1 goto :fail
docker builder prune -f --all
if errorlevel 1 goto :fail
echo === RESET zakonczony - startuje od zera ===

:check
REM --- Docker installed? ---
where docker >nul 2>nul
if errorlevel 1 (
    echo [BLAD] Nie znaleziono dockera w PATH. Zainstaluj Docker Desktop.
    goto :fail
)

REM --- Docker daemon running? ---
docker info >nul 2>nul
if errorlevel 1 (
    echo [BLAD] Demon Dockera nie dziala. Uruchom Docker Desktop i sprobuj ponownie.
    goto :fail
)

REM --- Root .env (required by docker-compose.yml) ---
if not exist ".env" (
    echo [INFO] Brak .env - tworze z domyslnymi wartosciami deweloperskimi...
    call :write_root_env
)

REM --- frontend\.env (VITE_FASTAPI_BASE_URL for the browser) ---
if not exist "frontend\.env" (
    echo [INFO] Brak frontend\.env - tworze z domyslna wartoscia...
    >  "frontend\.env" echo # Only VITE_-prefixed variables reach the browser.
    >> "frontend\.env" echo VITE_FASTAPI_BASE_URL=http://localhost:8001
)

echo.
echo [1/5] Budowanie obrazow...
docker compose build
if errorlevel 1 goto :fail

echo.
echo [2/5] Uruchamianie kontenerow...
docker compose up -d
if errorlevel 1 goto :fail

echo.
echo [3/5] Czekam na backend...
set /a ATTEMPTS=0
:wait_backend
set /a ATTEMPTS+=1
curl -s -f -o nul http://localhost:8001/health
if not errorlevel 1 goto :backend_up
if %ATTEMPTS% GEQ 60 (
    echo [BLAD] Backend nie odpowiada po ok. 2 minutach. Ostatnie logi:
    docker compose logs --tail 40 backend
    goto :fail
)
timeout /t 2 /nobreak >nul
goto :wait_backend
:backend_up
echo Backend dziala.

echo.
echo [4/5] Migracje bazy danych - alembic upgrade head...
docker compose exec -T backend alembic upgrade head
if errorlevel 1 goto :fail

echo.
echo [5/5] Seed danych deweloperskich - scripts/seed.py...
docker compose exec -T backend python scripts/seed.py
if errorlevel 1 goto :fail

echo.
echo ============================================================
echo  Gotowe!
echo    Frontend : http://localhost:5173
echo    Backend  : http://localhost:8001/docs   - Swagger UI
echo    SeaweedFS: http://localhost:8888         - filer web UI
echo.
echo  Konta testowe:
echo    admin@fake.academy / admin123!    administrator
echo    anna@fake.academy  / teacher123!  wykladowca
echo    kasia@fake.academy / student123!  student
echo ============================================================
exit /b 0

:fail
echo.
echo [BLAD] start.bat przerwany - zobacz komunikaty powyzej.
exit /b 1

REM ------------------------------------------------------------
REM Subroutine: write a root .env with dev defaults and a fresh
REM random JWT secret (two GUIDs = 64 hex chars, fine for HS256).
REM ------------------------------------------------------------
:write_root_env
set "GENERATED_JWT="
for /f "usebackq delims=" %%G in (`powershell -NoProfile -Command "[guid]::NewGuid().ToString('N')+[guid]::NewGuid().ToString('N')"`) do set "GENERATED_JWT=%%G"
if "%GENERATED_JWT%"=="" set "GENERATED_JWT=change-me-in-production-0123456789abcdef"
>  ".env" echo # Generated by start.bat - development defaults
>> ".env" echo FRONTEND_ENDPOINT=http://localhost:5173,http://127.0.0.1:5173
>> ".env" echo BACKEND_BASE_URL=http://localhost:8001
>> ".env" echo.
>> ".env" echo POSTGRES_USER=dev
>> ".env" echo POSTGRES_PASSWORD=dev
>> ".env" echo POSTGRES_DB=dev
>> ".env" echo.
>> ".env" echo S3_ENDPOINT=http://storage:8333
>> ".env" echo S3_LOCAL_ENDPOINT=http://localhost:8333
>> ".env" echo S3_ACCESS_KEY=dev
>> ".env" echo S3_SECRET_KEY=dev
>> ".env" echo S3_BUCKET=fake-academy
>> ".env" echo.
>> ".env" echo JWT_SECRET=%GENERATED_JWT%
>> ".env" echo JWT_EXPIRE_MINUTES=60
exit /b 0
